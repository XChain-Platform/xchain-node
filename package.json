{
  "name": "xchain-node",
  "version": "0.0.19",
  "description": "xchain-node allows users to install, configure and run XChain platform nodes.",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/XChain-platform/xchain-node.git"
  },
  "main": "src/index.js",
  "dependencies": {
    "axios": "^1.16.0",
    "blessed": "^0.1.81",
    "chalk": "^5.6.0",
    "commander": "^14.0.2",
    "dotenv": "^16.4.5",
    "enquirer": "^2.4.1",
    "follow-redirects": "^1.15.9",
    "mariadb": "3.1.1",
    "semver": "^7.6.3"
  },
  "scripts": {
    "test": "mocha 'test/unit/**/*.test.js' --timeout 10000 --recursive",
    "test:integration": "mocha 'test/integration/**/*.test.js' --timeout 30000 --recursive",
    "test:smoke": "mocha 'test/smoke/**/*.test.js' --timeout 5000 --exit --recursive",
    "test:e2e": "mocha 'test/e2e/**/*.test.js' --timeout 30000 --exit --recursive",
    "test:fuzz": "mocha 'test/fuzz/**/*.fuzz.test.js' --timeout 10000 --recursive",
    "test:chaos": "mocha 'test/chaos/**/*.chaos.test.js' --timeout 15000 --recursive",
    "test:regression": "mocha 'test/regression/**/*.test.js' --timeout 10000 --recursive",
    "test:regression:p0": "mocha 'test/regression/**/*.test.js' --grep '\\[regression:p0\\]' --timeout 10000 --recursive",
    "test:regression:p0p1": "mocha 'test/regression/**/*.test.js' --grep '\\[regression:p[01]\\]' --timeout 10000 --recursive",
    "test:all": "mocha 'test/smoke/**/*.test.js' 'test/unit/**/*.test.js' 'test/integration/**/*.test.js' 'test/e2e/**/*.test.js' 'test/fuzz/**/*.fuzz.test.js' 'test/chaos/**/*.chaos.test.js' 'test/regression/**/*.test.js' --timeout 30000 --recursive",
    "test:mutation": "npx stryker run",
    "test:mutation:config": "npx stryker run stryker.config.pilot.json",
    "benchmark": "node test/benchmarks/harness.js",
    "benchmark:quick": "node test/benchmarks/harness.js --quick"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/mocha-runner": "^8.7.1",
    "chai": "^4.5.0",
    "mocha": "^11.7.5",
    "proxyquire": "^2.1.3",
    "sinon": "^21.0.3"
  },
  "overrides": {
    "qs": "^6.15.2"
  },
  "bin": {
    "xchain_node": "./src/index.js"
  }
}
