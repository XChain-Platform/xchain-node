{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.json",
  "mutate": [
    "src/services/ConfigService.js"
  ],
  "testRunner": "mocha",
  "mochaOptions": {
    "spec": [
      "test/unit/ConfigService.test.js",
      "test/integration/config-pipeline.test.js"
    ],
    "no-config": true,
    "no-opts": true
  },
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/pilot/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/pilot/report.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "concurrency": 4,
  "tempDirName": ".stryker-tmp",
  "mutator": {
    "excludedMutations": [
      "StringLiteral"
    ]
  }
}
