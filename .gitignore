.env
node_modules/
.DS_Store
.stryker-tmp/
reports/mutation/

# Runtime coin-node data - created when nodes run. Never a repo artifact:
# includes wallet.dat (keys), chainstate/blocks, debug.log, peers.dat, *.pid,
# the xchain_node LevelDB module map, and E2E run logs. All regenerated at runtime.
data/

# Per-service library clones copied in at install (XCHAIN_NODE_MODULES_DIR).
modules/
# Per-install scratch: built container files, staged source copies (XCHAIN_NODE_TMP_DIR).
tmp/

# Downloaded + extracted coin-node binaries (XCHAIN_NODE_CRYPTO_NODES_DIR). The
# per-coin Dockerfile and *-{mainnet,testnet,regtest}.conf build sources stay tracked;
# only the fetched tarballs and the extracted <coin>/<coin>/ trees are ignored.
crypto_nodes/*/*.tar.gz
crypto_nodes/bitcoin/bitcoin/
crypto_nodes/dogecoin/dogecoin/
crypto_nodes/litecoin/litecoin/

# Per-coin/network node configs - never track (generated at install). The main files hold
# only non-secret operator overrides now, but stay ignored to protect any leftover files
# from older installs that haven't migrated yet.
config/*-mainnet
config/*-testnet
config/*-regtest
# Runtime RPC credentials live in untracked .local sidecars (rpcuser/rpcpassword).
config/*-*.local

# Coverage output (c8/nyc) - generated, not source
coverage/
.nyc_output/
